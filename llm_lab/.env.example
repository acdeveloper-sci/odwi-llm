# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# The lab never prints these values; scripts only check that they are present.

# Google AI Studio - https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# Groq - https://console.groq.com/keys (free plan)
GROQ_API_KEY=

# Local OpenAI-compatible endpoints (Task 5+). Strip the /v1 suffix for
# Ollama's native API when a later task needs it (format=json, num_ctx).
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
